# 服务端口
PORT=8080

# ============================================================
# Hermes Agent LLM provider 配置
# ------------------------------------------------------------
# 默认使用 MiniMax 中国端（provider id: minimax-cn）
# 文档: https://hermes-agent.nousresearch.com/docs/integrations/providers
# 后端会把这些值写入容器内的 /opt/data/.env 和 /opt/data/config.yaml
# ============================================================
HERMES_PROVIDER=minimax-cn
HERMES_DEFAULT_MODEL=MiniMax-M2.7

# 必填：MiniMax 中国端 API key
MINIMAX_CN_API_KEY=

# 可选：覆盖 MiniMax 中国端 base URL（一般不需要填）
# MINIMAX_CN_BASE_URL=

# 其它 provider 的 key（留空即可，按需填写后即可在前端选择对应模型）
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=

# ============================================================
# 镜像 / 容器命名
# ============================================================
HERMES_IMAGE_TAG=nousresearch/hermes-agent:latest

# 单次 chat 的超时（毫秒）。hermes 首次回答可能较慢
CHAT_TIMEOUT_MS=600000

# Hermes 工具子进程 HOME（用于 git/ssh/gh/npm 与 skill CLI 凭据）
HERMES_SUBPROCESS_HOME_IN_CONTAINER=/opt/data/home

# 是否启用按运行隔离的工作流产物目录（runs/{runId}）
RUN_SCOPED_ARTIFACTS=true

# Docker socket 连接方式：
#   - 留空：dockerode 走默认（Linux/macOS 使用 /var/run/docker.sock，Windows 使用 //./pipe/docker_engine）
#   - 显式 npipe（Windows）: //./pipe/docker_engine
#   - 显式 socket（Linux/macOS）: /var/run/docker.sock
DOCKER_SOCKET=

# ============================================================
# n8n workflow orchestration
# ============================================================
# n8n API base URL, for example: http://localhost:5678
N8N_BASE_URL=http://127.0.0.1:5678
# local n8n service port (used for default N8N_BASE_URL)
N8N_PORT=5678
# n8n API key (X-N8N-API-KEY). Optional for local instances without API-key auth.
N8N_API_KEY=
# Optional n8n incoming webhook base URL, for example: http://localhost:5678/webhook
N8N_WEBHOOK_BASE_URL=
# Shared secret used by n8n -> backend workflow webhooks
N8N_WEBHOOK_SECRET=
# Optional backend public URL reachable from n8n, e.g. http://host.docker.internal:8080
BACKEND_PUBLIC_BASE_URL=
